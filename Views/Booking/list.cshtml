@model System.Data.DataTable

<h2>Booking List</h2>

<table class="table table-bordered">
    <tr>
        <th>Booking ID</th>
        <th>Customer Name</th>
        <th>Email</th>
        <th>Check In</th>
        <th>Check Out</th>
    </tr>

    @foreach (System.Data.DataRow row in Model.Rows)
    {
        <tr>
            <td>@row["BookingId"]</td>
            <td>@row["CustomerName"]</td>
            <td>@row["Email"]</td>
            <td>@row["CheckInDate"]</td>
            <td>@row["CheckOutDate"]</td>
        </tr>
    }
</table>